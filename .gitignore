# Generated data (regenerate it with datagen.py and your seed)
shared-folder/input/*.csv
shared-folder/stream/*.jsonl

# Checkpoints and the saved model are local state, regenerated by the parts
shared-folder/checkpoint/*
!shared-folder/checkpoint/.gitkeep
shared-folder/models/*
!shared-folder/models/.gitkeep

# Spark output markers and temporary files (commit the part-... result files, not these)
shared-folder/output/**/_SUCCESS
shared-folder/output/**/_spark_metadata/
shared-folder/output/**/.*.crc
shared-folder/output/**/_temporary/

# Python
__pycache__/

# Operating system
.DS_Store
Thumbs.db
